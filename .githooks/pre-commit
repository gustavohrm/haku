#!/bin/sh
# Formats and lints what is about to be committed.
#
# Only the mechanical checks run here, the ones `.githooks/profile.sh` declares
# for the project's stack. Type checking and tests belong to the delivery gate:
# they take minutes, and a hook that slow gets bypassed until it may as well not
# exist.
#
# Files are read from the working tree rather than from the index, which matters
# for a file that is only partly staged. Such a file is never rewritten, because
# re-staging it would sweep in the parts deliberately left out of the commit, and
# it is checked as it sits on disk. That can fail a commit whose staged content
# is already clean; the alternative is skipping the file, which would let
# unformatted code through the one check meant to stop it.
#
# Bypass with `git commit --no-verify` when a commit has to land unfixed.
set -eu

# A closed stderr, as when the caller pipes git through `head`, would kill this
# hook with SIGPIPE mid-message, and git for Windows lets a commit through a hook
# killed that way. Ignoring the signal turns a failed write into an ordinary
# error, so the hook's own verdict is what sets its exit status.
trap "" PIPE

cd "$(git rev-parse --show-toplevel)"

# The profile replaces this with the commands that fix what its checks report.
PROFILE_FIX_HINT='Fix what is reported'

work=$(mktemp -d)
report() {
  status=$?
  if [ "$status" -ne 0 ]; then
    printf '\npre-commit failed. %s, or commit with --no-verify.\n' "$PROFILE_FIX_HINT" >&2
  fi
  rm -rf "$work"
  exit "$status"
}
trap report EXIT

# Runs a command over a newline-delimited file list, skipping an empty one.
run_on() {
  run_list=$1
  shift
  if [ -s "$run_list" ]; then
    tr '\n' '\0' <"$run_list" | xargs -0 "$@"
  fi
}

# Runs a command over the files in a list whose extension matches a `grep -E`
# alternation, such as `md` or `ts|tsx`, skipping the command when none does.
on_ext() {
  ext_list=$1
  ext=$2
  shift 2
  grep -E "\.($ext)\$" "$ext_list" >"$work/on_ext" || true
  run_on "$work/on_ext" "$@"
}

# The stack's checks. The profile sets PROFILE_EXTENSIONS, the extensions any of
# them reads, as a `grep -E` alternation, and PROFILE_FIX_HINT; and it defines
# profile_fix, which rewrites, and profile_check, which checks, the
# newline-delimited file list in "$1", typically through on_ext.
# Without one there is nothing to run, as in the template repository, whose
# profiles are checked by its own workflow instead.
if [ ! -f .githooks/profile.sh ]; then
  printf 'pre-commit: no .githooks/profile.sh, so no stack checks ran.\n' >&2
  exit 0
fi
. ./.githooks/profile.sh

# `core.quotePath=false` lists a path with non-ASCII characters as it is. Quoted, as
# `"caf\303\251.md"`, it would match no extension below and go unchecked.
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR |
  grep -E "\.($PROFILE_EXTENSIONS)\$" >"$work/staged" || true

if [ ! -s "$work/staged" ]; then
  exit 0
fi

git -c core.quotePath=false diff --name-only >"$work/unstaged" || true
grep -Fxv -f "$work/unstaged" "$work/staged" >"$work/fixable" || true

if [ -s "$work/fixable" ]; then
  profile_fix "$work/fixable"
  # Literal pathspecs, so a name such as `app/[id]/page.tsx` is not read as a
  # pattern that also stages the unstaged changes of `app/i/page.tsx`.
  run_on "$work/fixable" git --literal-pathspecs add --
fi

profile_check "$work/staged"
