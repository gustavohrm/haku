{
  // The repository's own code outside the workspace packages: the root config files and `scripts/`.
  "extends": "./tsconfig.base.json",
  // Node.js runs these files directly, with type stripping and no bundler, so they are checked by Node's rules:
  // its types, NodeNext resolution, and relative imports written with the file's own extension, `.ts` or
  // `.mjs`, as Node requires.
  "compilerOptions": {
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.root.tsbuildinfo"
  },
  "include": ["*.ts", "*.mjs", "scripts/**/*.ts", "scripts/**/*.mjs"]
}
