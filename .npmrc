# The toolchain is pinned so a local run and a CI run resolve the same versions:
# `engines` in package.json declares the range, `.nvmrc` names the exact Node,
# `packageManager` names the exact pnpm, and `rust-toolchain.toml` names the
# exact Rust. This makes pnpm refuse an install outside the declared range
# instead of only printing a warning, so a mismatch surfaces before it turns into
# a failure no one can reproduce.
engine-strict=true
