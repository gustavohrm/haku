{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "ignorePatterns": ["dist/**", "coverage/**", "src/bindings.ts", "tauri/target/**", "**/*.md"],
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "trailingComma": "all"
}
