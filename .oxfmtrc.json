{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortTailwindcss": true,
  "bracketSpacing": true,
  "htmlWhitespaceSensitivity": "ignore",
  "ignorePatterns": [
    // Generated from Rust by `pnpm bindings`, and left as its generator writes it.
    "src/bindings.ts",
    "tauri/target/**",
    "**/*.md"
  ],
  "printWidth": 120,
  "semi": true,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "trailingComma": "all"
}
