{
  "name": "haku",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "node .githooks/install.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "bindings": "cargo test --manifest-path tauri/Cargo.toml --lib ipc::tests::export_bindings -- --exact",
    "bindings:check": "node scripts/check-bindings.mjs",
    "check:release": "cargo check --manifest-path tauri/Cargo.toml --locked --release",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path tauri/Cargo.toml --locked",
    "format": "pnpm format:check",
    "format:check": "pnpm format:check:web && pnpm format:check:rust",
    "format:check:web": "oxfmt --check && prettier --check --log-level warn \"**/*.md\"",
    "format:check:rust": "cargo fmt --manifest-path tauri/Cargo.toml --check",
    "format:fix": "oxfmt --write && prettier --write --log-level warn \"**/*.md\" && cargo fmt --manifest-path tauri/Cargo.toml",
    "lint:check": "pnpm lint:check:web && pnpm lint:check:rust",
    "lint:check:web": "oxlint --deny-warnings",
    "lint:check:rust": "cargo clippy --manifest-path tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "lint:fix": "oxlint --fix",
    "verify": "pnpm verify:web && pnpm verify:rust",
    "verify:web": "pnpm format:check:web && pnpm lint:check:web && pnpm typecheck && pnpm test && vite build",
    "verify:rust": "pnpm format:check:rust && pnpm lint:check:rust && pnpm bindings:check && pnpm test:rust",
    "labels": "node scripts/sync-labels.mjs"
  },
  "dependencies": {
    "@codenhub/icons": "^0.2.1",
    "@codenhub/styles": "^0.6.0",
    "@codenhub/theme": "^0.1.2",
    "@codenhub/toaster": "^0.2.0",
    "@tauri-apps/api": "^2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0"
}
