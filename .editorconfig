root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
# rustfmt's own indentation; `tauri/rustfmt.toml` sets the width.
indent_size = 4

[*.md]
# A trailing double space is a Markdown line break.
trim_trailing_whitespace = false
# Prose is not hard-wrapped; Prettier runs with proseWrap "never" and reads this
# as an unlimited print width, which also keeps wide tables aligned.
max_line_length = off
